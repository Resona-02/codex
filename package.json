{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "面向对象的 SVG 命令行编辑器：Command + Composite",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "cli": "npm run build --silent && node dist/src/main.js",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
